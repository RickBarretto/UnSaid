{
  "name": "unsaid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 1420 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun test tests/unit",
    "test:browser": "playwright test",
    "test:ui": "playwright test --ui",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
